{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        ".next/**",
        "dist/**"
      ],
      "env": [
        "NEXT_PUBLIC_API_URL",
        "NEXT_PUBLIC_SITE_URL"
      ],
      "passThroughEnv": [
        "MONGODB_URI",
        "JWT_ACCESS_SECRET",
        "WEB_ORIGIN",
        "EMAIL_PROVIDER",
        "EMAIL_FROM",
        "RESEND_API_KEY",
        "CRON_SECRET",
        "STORAGE_DRIVER",
        "STORAGE_DIR",
        "S3_ENDPOINT",
        "S3_BUCKET",
        "S3_ACCESS_KEY",
        "S3_SECRET_KEY",
        "S3_PATH_STYLE",
        "BLOB_READ_WRITE_TOKEN",
        "BLOB_WEBHOOK_PUBLIC_KEY",
        "BLOB_STORE_ID",
        "ROOFV_ENABLED",
        "ROOFV_API_KEY",
        "ROOFV_API_BASE",
        "PAYMENT_PROVIDER",
        "STRIPE_SECRET_KEY",
        "STRIPE_WEBHOOK_SECRET"
      ]
    },
    "lint": {},
    "typecheck": {},
    "test": {}
  }
}
