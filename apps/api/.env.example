NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://localhost:27017/roofdesk?replicaSet=rs0
WEB_ORIGIN=http://localhost:3000
# Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=change-me-change-me-change-me-change-me
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Payments. Leave as "mock" for local development (no real money moves).
PAYMENT_PROVIDER=mock
# Optional India MVP: contractor-owned Razorpay short links. Keep false until you enable it deliberately.
RAZORPAY_LINKS_ENABLED=false
# API-created Test Mode links only. Store a different Razorpay Test key pair per contractor in Settings.
RAZORPAY_API_ENABLED=false
# Generate a base64-encoded 32-byte key (for example: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
RAZORPAY_CREDENTIALS_ENCRYPTION_KEY=
# Public HTTPS origin of the API, used to show the per-company webhook URL in Settings.
PUBLIC_API_URL=
# For Stripe test mode: PAYMENT_PROVIDER=stripe, then set both keys. Webhook endpoint: POST /api/v1/webhooks/stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email. "log" prints messages to the API console. For real delivery: EMAIL_PROVIDER=resend with a verified sender.
EMAIL_PROVIDER=log
EMAIL_FROM="RoofDesk <no-reply@yourdomain.com>"
RESEND_API_KEY=

# Vercel Cron daily reminder endpoint; generate a random secret with at least 32 characters.
CRON_SECRET=

# Files. "local" writes to STORAGE_DIR (development). For Vercel, use a private Blob store:
#   STORAGE_DRIVER=vercel-blob  (Vercel injects BLOB_READ_WRITE_TOKEN when the store is connected)
# For MinIO from docker-compose:
#   STORAGE_DRIVER=s3  S3_ENDPOINT=http://localhost:9000  S3_BUCKET=roofdesk  S3_ACCESS_KEY=roofdesk  S3_SECRET_KEY=roofdesk-secret  S3_PATH_STYLE=true
STORAGE_DRIVER=local
STORAGE_DIR=./storage
