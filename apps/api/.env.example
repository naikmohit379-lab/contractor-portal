NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://localhost:27017/roofdesk?replicaSet=rs0
WEB_ORIGIN=http://localhost:3000
# Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=change-me-change-me-change-me-change-me
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Payments. Leave as "mock" for local development (no real money moves).
PAYMENT_PROVIDER=mock
# For Stripe test mode: PAYMENT_PROVIDER=stripe, then set both keys. Webhook endpoint: POST /api/v1/webhooks/stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email. "log" prints messages to the API console. For real delivery: EMAIL_PROVIDER=resend with a verified sender.
EMAIL_PROVIDER=log
EMAIL_FROM="RoofDesk <no-reply@yourdomain.com>"
RESEND_API_KEY=

# Files. "local" writes to STORAGE_DIR (development). For MinIO from docker-compose:
#   STORAGE_DRIVER=s3  S3_ENDPOINT=http://localhost:9000  S3_BUCKET=roofdesk  S3_ACCESS_KEY=roofdesk  S3_SECRET_KEY=roofdesk-secret  S3_PATH_STYLE=true
STORAGE_DRIVER=local
STORAGE_DIR=./storage
