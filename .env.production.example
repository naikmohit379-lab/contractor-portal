# Copy to .env on the server (chmod 600 .env). Never commit the real file.

# The address people will use, with no https:// in front. DNS must point at this server.
DOMAIN=app.yourcompany.com

# Where the images are pulled from, and which version to run. The deploy workflow sets TAG.
IMAGE_PREFIX=ghcr.io/your-github-name/your-repo
TAG=latest

# Database password. Letters and numbers only, so it is safe inside a connection address:  openssl rand -hex 24
MONGO_PASSWORD=
BACKUP_KEEP_DAYS=14

# Login tokens:  openssl rand -hex 32
JWT_ACCESS_SECRET=

# Payments. Start with "mock" to rehearse; switch to stripe with TEST keys first.
PAYMENT_PROVIDER=mock
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email. "log" only prints messages on the server. Use resend for real delivery.
EMAIL_PROVIDER=resend
EMAIL_FROM="Your Company <no-reply@yourcompany.com>"
RESEND_API_KEY=

# Files. "local" stores them in a Docker volume on this server (back it up). Use s3 to keep them off the server.
STORAGE_DRIVER=local
# S3_ENDPOINT=
# S3_BUCKET=
# S3_REGION=us-east-1
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_PATH_STYLE=false
